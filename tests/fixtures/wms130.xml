<?xml version="1.0" encoding="UTF-8"?>
<WMS_Capabilities version="1.3.0" xmlns="http://www.opengis.net/wms" xmlns:xlink="http://www.w3.org/1999/xlink">
  <Service>
    <Name>WMS</Name>
    <Title>Geoportale Regionale - Servizio WMS</Title>
    <Abstract>Cartografia di base e tematica della Regione.</Abstract>
    <KeywordList><Keyword>cartografia</Keyword><Keyword>WMS</Keyword></KeywordList>
    <ContactInformation>
      <ContactPersonPrimary><ContactPerson>Ufficio SIT</ContactPerson><ContactOrganization>Regione Esempio</ContactOrganization></ContactPersonPrimary>
      <ContactElectronicMailAddress>sit@regione.example</ContactElectronicMailAddress>
    </ContactInformation>
    <Fees>none</Fees>
    <AccessConstraints>CC BY 4.0</AccessConstraints>
  </Service>
  <Capability>
    <Layer>
      <Title>Tutti i layer</Title>
      <CRS>EPSG:4326</CRS><CRS>EPSG:6707</CRS>
      <EX_GeographicBoundingBox><westBoundLongitude>9.5</westBoundLongitude><eastBoundLongitude>12.5</eastBoundLongitude><southBoundLatitude>42.2</southBoundLatitude><northBoundLatitude>44.5</northBoundLatitude></EX_GeographicBoundingBox>
      <Layer queryable="1">
        <Name>ortofoto_2022</Name>
        <Title>Ortofoto 2022</Title>
        <Abstract>Ortofoto a colori 20 cm.</Abstract>
        <KeywordList><Keyword>ortofoto</Keyword></KeywordList>
        <MetadataURL type="ISO19115:2003"><Format>text/xml</Format><OnlineResource xlink:type="simple" xlink:href="https://geo.regione.example/csw?request=GetRecordById&amp;id=orto2022"/></MetadataURL>
      </Layer>
      <Layer>
        <Title>Gruppo idrografia</Title>
        <CRS>EPSG:3003</CRS>
        <Layer><Name>idro:fiumi</Name><Title>Fiumi</Title>
          <EX_GeographicBoundingBox><westBoundLongitude>10</westBoundLongitude><eastBoundLongitude>11</eastBoundLongitude><southBoundLatitude>43</southBoundLatitude><northBoundLatitude>44</northBoundLatitude></EX_GeographicBoundingBox>
        </Layer>
        <Layer><Name>idro:laghi</Name><Title>Laghi</Title></Layer>
      </Layer>
    </Layer>
  </Capability>
</WMS_Capabilities>
